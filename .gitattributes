# Keep text files LF everywhere, matching Prettier's default endOfLine.
# Overrides core.autocrlf so Windows checkouts don't convert to CRLF.
* text=auto eol=lf

# Binary files: never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
